---
import '../styles/global.css';
import PasswordGate from '../components/PasswordGate.astro';

interface Props {
  title: string;
  bare?: boolean;
}

const { title, bare = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400&family=Inter:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <PasswordGate />
    <div class="site-content">
      {bare ? (
        <slot />
      ) : (
        <>
          <nav class="page-nav">
            <a href="/">Kade Dalton</a>
          </nav>
          <main>
            <slot />
          </main>
        </>
      )}
    </div>
  </body>
</html>
