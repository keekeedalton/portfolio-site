---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('case-studies', 'consult-ai-screener');
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} bare>
  <div class="secret-v2-page">
    <header class="secret-v2-header">
      <div class="secret-v2-topline">
        <a href="/">Kade Dalton</a>
        <span>·</span>
        <a href="/#work">Work</a>
      </div>

      <p class="secret-v2-kicker">Secret concept / v2</p>
      <h1>{entry.data.title}</h1>
      <p class="secret-v2-summary">{entry.data.summary}</p>

      <div class="secret-v2-meta">
        <div>
          <span>Role</span>
          <strong>{entry.data.role}</strong>
        </div>
        <div>
          <span>Discipline</span>
          <strong>{entry.data.discipline}</strong>
        </div>
        <div>
          <span>Focus</span>
          <strong>AI legal review workflows</strong>
        </div>
      </div>
    </header>

    <div class="secret-v2-layout">
      <main class="secret-v2-content">
        <Content />
      </main>
    </div>
  </div>
</BaseLayout>
